{
  "name": "@hostai/web",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "panda codegen",
    "dev": "vp dev --host 127.0.0.1 --port 3000",
    "build": "panda codegen && vp build",
    "check": "panda codegen && tsc --noEmit && vp lint && vp fmt --check",
    "format": "vp fmt",
    "test": "vp test run",
    "test:ui": "playwright test",
    "start": "node server.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geist-mono": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "@tanstack/react-router": "1.170.33",
    "@tanstack/react-start": "1.168.50",
    "lucide-react": "1.43.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@pandacss/dev": "1.12.1",
    "@playwright/test": "1.63.0",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "7.0.2",
    "vite-plus": "0.3.1"
  }
}
